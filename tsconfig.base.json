{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@agenta/shared": ["./packages/shared/src/index.ts"],
      "@agenta/shared/*": ["./packages/shared/src/*"],
      "@agenta/db": ["./packages/db/src/index.ts"],
      "@agenta/db/*": ["./packages/db/src/*"]
    }
  }
}
