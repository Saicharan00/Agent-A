# Agent A environment. Copy to .env.local (git-ignored) and edit there.
# Both apps load <repo>/.env.local at startup; variables already set in the shell win.

# --- Web (Next.js) ---
# Bind host for the web UI. Default 127.0.0.1 (CLAUDE.md rule).
# To open the UI from the Windows browser through `sbx` port publishing, the web server must
# listen on the sandbox VM's network interface: set AGENTA_WEB_HOST=0.0.0.0 (see docs/DECISIONS.md).
AGENTA_WEB_HOST=127.0.0.1
AGENTA_WEB_PORT=3000
# Where the web server proxies /api/* to (server-side only; the runner is never exposed).
AGENTA_RUNNER_URL=http://127.0.0.1:3001

# --- Runner (Fastify) ---
AGENTA_RUNNER_HOST=127.0.0.1
AGENTA_RUNNER_PORT=3001
# Only origin allowed by the runner's CORS policy.
AGENTA_WEB_ORIGIN=http://localhost:3000
# SQLite file (absolute, or relative to the repo root). Migrations run automatically on runner start.
AGENTA_DB_PATH=data/agenta.db
# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Bot computers (F05) ---
# Bot homes (<dir>/<botId>/home → /home/bot) and the team share (→ /shared). Absolute or repo-relative.
# They must support symlinks: scripts/vm-mounts.sh bind-mounts data/bots and data/shared from the VM disk.
AGENTA_BOTS_DIR=data/bots
AGENTA_SHARED_DIR=data/shared
# Set to 0 to run the runner without Docker (computer routes return docker_unavailable).
AGENTA_DOCKER=1

# --- Engines ---
# Claude Code subscription token from `claude setup-token` (run `pnpm auth:claude`). Injected into Claude runs only.
# Edits are picked up without a restart (Settings → Engines → Re-check). Never commit or paste it into chat.
CLAUDE_CODE_OAUTH_TOKEN=
# Engine credentials folder: <dir>/codex/auth.json comes from `pnpm auth:codex` (mode 600). Git-ignored.
AGENTA_SECRETS_DIR=data/secrets
# Force every run onto the scripted mock engine (set automatically by Playwright). Leave empty for real engines.
AGENTA_ENGINE_OVERRIDE=
